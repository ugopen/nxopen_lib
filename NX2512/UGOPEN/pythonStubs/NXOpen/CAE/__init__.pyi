import NXOpen
class PostScenarioVariableDomain(NXOpen.TransientObject): 
    """  Models the measure and unit used by CAE.PostScenarioResultGroupVariable 

        
        
        A Variable Domain is made up of N components. The base components can be used as-is as a single component in a
        Variable Domain to identify base quantities such as Pressure, Frequency, Length etc. 
        
        
        For advanced use of Scenario-based Data Visualization, you may have to use complex Variable Domain expressions
        to build, for example, rational quantities, such as transfer functions, power spectrum densities etc, or even to
        better identify the various types of velocities (such as structural velocity, fluid velocity, sound speed, etc).
        
        
        For the former, adding multiple base domain components to a Variable Domain puts those components in a multiplication
        relation. For example, Pressure Squared is built using (NXOpen for Python): 
            vd = part.PostScenarioMgr.NewVariableDomain()
            vd.AddComponent("pressure", [])
            vd.AddComponent("pressure", [])
        
        
        
        To build a power spectrum density of pressure, we need to introduce a division operation, which is used using the
        special base domain called "rational_support": 
            vd = part.PostScenarioMgr.NewVariableDomain()
            vd.AddComponent("pressure", [])
            vd.AddComponent("pressure", [])
            vd.AddComponent("rational_support", ["over"])
            vd.AddComponent("frequency", [])
        
        
        
        The base domains can be retrieved using CAE.PostScenarioVariableDomain.GetAllBaseDomains. Subdomains
        can be retrieved using CAE.PostScenarioVariableDomain.GetAllSubdomains and passing in a base domain.
        Not all base domains have subdomains.
        
        
        Subdomains can identify distinctions in quantity or location: 
            # can be used to identify data modeled on a structural vibro-acoustic mesh
            vdStructure = part.PostScenarioMgr.NewVariableDomain()
            vdStructure.AddComponent("node", ["node_structural"])
            # can be used to identify data modeled on a fluid acoustic mesh
            vdFluid = part.PostScenarioMgr.NewVariableDomain()
            vdFluid.AddComponent("node", ["node_fluid"])
        
        
        
     """
    def AddComponent(self, baseDomain: str, subdomains: List[str]) -> None:
        """
         Add a domain component to this domain.
                    
                    
                    A full Variable Domain is composed of a number of components that find themselves
                    in a product relation. Most of the time you only have one base domain representing
                    the quantity you are referring to. In that case, consider using API overloads
                    that accept a plain string.
                    
                    
                    This class is meant to support advanced and specific Rational Quantities, or specific
                    subdomains of a Quantity.
                    
                    
                    A rational quantity, such as "PressureForce" (a transfer function), is built as such: 
                    vd = part.PostScenarioMgr.NewVariableDomain()
                    vd.AddComponent("pressure", [])
                    vd.AddComponent("rational_support", ["over"])
                    vd.AddComponent("force", [])
                    
                    
                    
                    A different example, like a Force auto-power, is built as: 
                    vd = part.PostScenarioMgr.NewVariableDomain()
                    vd.AddComponent("force", [])
                    vd.AddComponent("rational_support", ["cross"])
                    vd.AddComponent("force", [])
                    
                    
                    
                  
        """
        pass
    def Dispose(self) -> None:
        """
         Dispose of this instance. 
        """
        pass
    def GetAllBaseDomains(self) -> List[str]:
        """
         Retrieve a list of supported base domains. 
         Returns domains (List[str]): .
        """
        pass
    def GetAllSubdomains(self, baseDomain: str) -> List[str]:
        """
         Retrieve a list of supported subdomains given a base domain. 
         Returns subdomains (List[str]): .
        """
        pass
    def GetMeasure(self) -> str:
        """
         Retrieve the base Measure name corresponding to this Variable Domain, which can be used with the Unit API. 
         Returns measureName (str): .
        """
        pass
    def GetNthComponent(self, n: int) -> Tuple[str, List[str]]:
        """
         Retrieve the nth component. 
         Returns A tuple consisting of (baseDomain, subdomains). 
         - baseDomain is: str.
         - subdomains is: List[str].

        """
        pass
    def GetNumberOfComponents(self) -> int:
        """
         Retrieve the number of components. 
         Returns numComponents (int): .
        """
        pass
    def GetUnit(self) -> NXOpen.Unit:
        """
         Retrieve the unit used in Scenario Post Processing for this Variable Domain. 
         Returns unit ( NXOpen.Unit): .
        """
        pass
    def MatchDomainPattern(self, domain_pattern: PostScenarioVariableDomain) -> bool:
        """
         Check if this VariableDomain matches a domain pattern that may contain wildcards.
                    
                    This is useful for detecting rational measures such as Response Functions, Power Spectral Density Functions and so on.
                    The comparison works as such:
                        It checks each base domain in domain_pattern is present in this value
                        For each base domain, it checks that all subdomains listed in domain_pattern are present in this value
                        A domain of rational_support { wildcard } is matched to anything
                        If the first domain in domain_pattern is rational_support { not }, then the comparison will be reversed for the remaining domains
                        Base domains are checked in order
                        Subdomains are compared via set inclusion, so order does not matter
                       
                     
                    
                  
         Returns matched (bool): .
        """
        pass
