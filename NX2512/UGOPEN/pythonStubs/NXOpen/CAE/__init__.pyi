class AfuDataConvertor(NXOpen.Object): 
    """ Convert data values for the AFU Data Record """
    class Fft(Enum):
        """
        Members Include: 
         |Forward|  Forward FFT 
         |Inverse|  Inverse FFT 

        """
        Forward: int
        Inverse: int
        @staticmethod
        def ValueOf(value: int) -> AfuDataConvertor.Fft:
            """
            Returns enum member equivalent to the value passed. Useful for bit operations of enum members.
            """
            pass
    def GetFftComplexType(fft_type: AfuDataConvertor.Fft, in_complex_type: AfuData.OrdinateType) -> AfuData.OrdinateType:
        """
         Get the complex type of ordinate data by FFT 
         Returns out_complex_type ( AfuData.OrdinateType NXOp):  Complex type of ordinate data after FFT .
        """
        pass
    def GetFftFrequencyData(in_x_values: List[float], in_y_values: List[float]) -> Tuple[List[float], List[float], List[float]]:
        """
         Get the values by Forward FFT.
                    The input data should be Real data on Time domain and
                    the output data will be Complex data on Frequency domain. 
         Returns A tuple consisting of (z_values, x_values, y_values). 
         - z_values is: List[float]. Imaginary part of Y values of the output data .
         - x_values is: List[float]. X values of the output data .
         - y_values is: List[float]. Real part of Y values of the output data .

        """
        pass
    def GetFftTimeData(in_x_values: List[float], in_y_values: List[float], in_z_values: List[float]) -> Tuple[List[float], List[float]]:
        """
         Get the values by Inverse FFT.
                    The input data should be Complex data on Frequency domain
                    and the output data will be Real data on Time domain. 
         Returns A tuple consisting of (y_values, x_values). 
         - y_values is: List[float]. Y values of the output data .
         - x_values is: List[float]. X values of the output data .

        """
        pass
