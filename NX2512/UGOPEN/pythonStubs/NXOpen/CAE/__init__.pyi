class PostScenarioCoordinateSystemTransformation(NXOpen.TransientObject): 
    """ This is the base class for coordinate system transformations in Scenario-based Data Visualization.
        
        See PostScenarioCoordinateSystemTransformationType to check available transformations.
        
      """
    @property
    def AssumeResultsAreInGlobal(self) -> bool:
        """
        Getter for property: (bool) AssumeResultsAreInGlobal
         Returns the option of whether to allow conversion to take place instead of failing.  
          
                    
                      If this flag is disabled, coordinate system transformations will take place only if result coordinate systems can be retrieved
                    from the same data source (c.f.
            ##  CAE.PostScenarioQueryCont). If these are
                    available, they will be used to convert data to the absolute coordinate system before applying additional transformation. If these
                    are not available, the conversion will not perform any change to the data.  
                      If this flag is enabled, and result coordinate systems are available, this functions as if it were disabled. However, if
                    result coordinate systems are not available, then the system will assume data is already in the global coordinate system, and apply
                    additional operations.  
                      Whether or not this flag should be enabled depends on how data is stored in a particular data source.  
                      The default value for this flag is 'Disabled'.  
                    
                    
         
        """
        pass
    @AssumeResultsAreInGlobal.setter
    def AssumeResultsAreInGlobal(self, flag: bool):
        """
        Setter for property: (bool) AssumeResultsAreInGlobal
         Returns the option of whether to allow conversion to take place instead of failing.  
          
                    
                      If this flag is disabled, coordinate system transformations will take place only if result coordinate systems can be retrieved
                    from the same data source (c.f.
            ##  CAE.PostScenarioQueryCont). If these are
                    available, they will be used to convert data to the absolute coordinate system before applying additional transformation. If these
                    are not available, the conversion will not perform any change to the data.  
                      If this flag is enabled, and result coordinate systems are available, this functions as if it were disabled. However, if
                    result coordinate systems are not available, then the system will assume data is already in the global coordinate system, and apply
                    additional operations.  
                      Whether or not this flag should be enabled depends on how data is stored in a particular data source.  
                      The default value for this flag is 'Disabled'.  
                    
                    
         
        """
        pass
    def Convert(self, plots: List[PostScenarioPlotData]) -> PostScenarioQueryResults:
        """
         Perform the conversion.
                    
                    Note: coordinate system conversion is dependent on the data source having both result coordinate systems available in the data source, and having all degrees of freedom  components available.
                    As such, conversions may not be performed at all, or they may be performed partially. If a conversion is performed successfully, then the plot will be marked with the "Converted"
                    metadata which contains a unicode string detailing to what coordinate system it was converted to. See CAE.PostScenarioMetadata.Converted.
                    Conversions can only be applied to vector or tensor data that are defined on a target location and have multiple degrees of freedom  components.
                    Note: only the plots that you provide to this method will yield; other plots are queried temporarily in order to project the result to the new coordinate system, but
                    the temporary plots shall be discarded, leaving only the plots you have provided in the output QueryResults
                    The structure of the output CAE.PostScenarioQueryResults is similar to the input QueryResults provided to your transformation function.
                    Plots which cannot be converted are passed through.
                    We recommend making as few calls to this method as possible (prefer batch conversion instead of one-by-one conversions).
                    
                  
         Returns converted ( PostScenarioQueryResults NXOp):  If plots are converted, they will be marked with the "Converted" metadata. See CAE.PostScenarioMetadata.Converted. .
        """
        pass
    def Dispose(self) -> None:
        """
         Destroys the object. 
        """
        pass
