##         relation. For example, Pressure Squared is built using (NXOpen for Python):  @code 
##             vd = part.PostScenarioMgr.NewVariableDomain()
##             vd.AddComponent("pressure", [])
##             vd.AddComponent("pressure", [])
##          @endcode 
