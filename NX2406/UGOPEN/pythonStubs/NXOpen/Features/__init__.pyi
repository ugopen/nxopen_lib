        NoIssues: int
        BrokenLink: int
        OutOfDate: int
        SourceNotLoaded: int
        SourceSuppressed: int
        Suppressed: int
        NotPlanar: int
        InvalidFeature: int
        InvalidInput: int
        MultipleCoplanarSketches: int
        SomeConstraintsNotTransferred: int
        BrokenLinkNullXform: int
        MultipleXform: int
        SingleSourceMultipleLinks: int
        MultipleSketchesWithNonParallelNormals: int
        MultipleCurvesJoinedIntoOneLinkedCurve: int
        LinkedCurveDifferentFromSourceCurve: int
        MultipleInstanceOfASourcePart: int
        BrokenExtract: int
        OutOfDateExtract: int
        ExtractSourceSuppressed: int
        ExtractSomeConstraintsNotTransferred: int
