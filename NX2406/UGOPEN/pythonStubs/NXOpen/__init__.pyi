class CDF(TaggedObject): 
    """
    Represents a <ja_class>NXOpen.CDF</ja_class>, which is a representation of an NX color palette.  The 
    color palette contains 217 colors each represented here by a <ja_class>NXOpen.ColorDefinition</ja_class>.
